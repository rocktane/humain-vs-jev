# Copier vers .env : chargé automatiquement au démarrage, sans écraser les variables du shell.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.14.0
JEV_TIMEOUT=20s
ADDR=127.0.0.1:8080
CORPUS_MANIFEST=corpus/manifest.json
STATS_FILE=stats.json
PUBLIC_HOST=
TRUST_PROXY=0
GAMES_PER_HOUR=20
DAILY_CALLS=1000
MAX_CONCURRENT_CALLS=8
